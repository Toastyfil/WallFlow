{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WallFlow",
  "version": "1.2.0",
  "identifier": "com.wallflow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:renderer",
    "beforeBuildCommand": "npm run build:renderer",
    "devUrl": "http://localhost:5199",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WallFlow",
        "theme": "Dark",
        "width": 1360,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "decorations": true,
        "backgroundColor": "#0b0c0f"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "WallFlow",
    "copyright": "Copyright © 2026 WallFlow",
    "shortDescription": "A lightweight, modern wallpaper manager for Windows",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
