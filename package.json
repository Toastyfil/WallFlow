{
  "name": "wallflow",
  "productName": "WallFlow",
  "version": "1.0.1",
  "description": "A lightweight, modern wallpaper manager for Windows",
  "author": "WallFlow",
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:renderer && npm run build:electron && electron-builder --win --x64",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "icon": "node scripts/generate-icon.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "start": "electron .",
    "rebuild": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "axios": "^1.21.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "build": {
    "appId": "com.wallflow.desktop",
    "productName": "WallFlow",
    "copyright": "Copyright © 2026 WallFlow",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!dist/*.exe",
      "!dist/*.yml",
      "!dist/*.blockmap",
      "!dist/win-unpacked/**",
      "!dist/builder-*"
    ],
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WallFlow",
      "deleteAppDataOnUninstall": false
    }
  }
}
